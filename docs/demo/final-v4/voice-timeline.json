  "cues": [
    {
      "start": 2.3,
      "end": 4.24,
      "text": "The band is already on the road.",
      "source": "main"
    },
    {
      "start": 4.48,
      "end": 5.82,
      "text": "Then the message comes:",
      "source": "main"
    },
    {
      "start": 6.16,
      "end": 7.84,
      "text": "Tonight’s show is cancelled.",
      "source": "main"
    },
    {
      "start": 10.23,
      "end": 13.77,
      "text": "For the person everyone calls, that’s more than a blank date.",
      "source": "main"
    },
    {
      "start": 14.33,
      "end": 15.57,
      "text": "The crew needs a plan.",
      "source": "main"
    },
    {
      "start": 16.09,
      "end": 18.21,
      "text": "Four other shows still have to happen.",
      "source": "main"
    },
    {
      "start": 18.82,
      "end": 21.94,
      "text": "Tour Rescue helps you find the next move.",
      "source": "main"
    },
    {
      "start": 22.97,
      "end": 26.07,
      "text": "Compare a replacement, a detour, or a day off.",
      "source": "main"
    },
    {
      "start": 26.23,
      "end": 28.29,
      "text": "Keep confirmed shows fixed.",
      "source": "main"
    },
    {
      "start": 29.2,
      "end": 31.4,
      "text": "A chart shows the trade-off.",
      "source": "corrections"
    },
    {
      "start": 31.52,
      "end": 34.16,
      "text": "Qloo adds evidence about where the music fits.",
      "source": "main"
    },
    {
      "start": 36.64,
      "end": 37.6,
      "text": "Test the trade-off.",
      "source": "main"
    },
    {
      "start": 38.02,
      "end": 39.42,
      "text": "In this synthetic demo,",
      "source": "main"
    },
    {
      "start": 39.62,
      "end": 41,
      "text": "a little more extra distance",
      "source": "main"
    },
    {
      "start": 41,
      "end": 44.14,
      "text": "changes the recommendation from Nuremberg to Frankfurt.",
      "source": "main"
    },
    {
      "start": 49.46,
      "end": 50.34,
      "text": "See the reasons.",
      "source": "main"
    },
    {
      "start": 50.8,
      "end": 52.2,
      "text": "Keep the unknowns visible.",
      "source": "main"
    },
    {
      "start": 54.34,
      "end": 57.44,
      "text": "Take a concrete brief to the next promoter conversation.",
      "source": "main"
    },
    {
      "start": 58.16,
      "end": 61.64,
      "text": "Availability, fees and bookings still need human confirmation.",
      "source": "main"
    },
    {
      "start": 62.32,
      "end": 63.28,
      "text": "Need another lead?",
      "source": "main"
    },
    {
      "start": 63.6,
      "end": 65.4,
      "text": "Research it, check its sources,",
      "source": "main"
    },
    {
      "start": 65.5,
      "end": 67.34,
      "text": "then choose what enters your comparison.",
      "source": "main"
    },
    {
      "start": 69.33,
      "end": 71.71,
      "text": "For tour managers and independent bookers.",
      "source": "main"
    },
    {
      "start": 72.05,
      "end": 73.89,
      "text": "On the road, or back at the desk.",
